{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}{{ if .Root }} (admin){{ end }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "background": "transparent",
          "template": "\n╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "#444444",
          "foreground": "#eeeeee",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "plain",
          "background": "#444444",
          "foreground": "#0087af",
          "template": "<#949494></> {{ .Path }} ",
          "properties": {
            "style": "powerlevel",
            "max_width": 80,
            "folder_separator_icon": "/"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "background": "#444444",
          "foreground": "#5fd700",
          "template": "<#949494></> {{ .HEAD }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }} ",
          "properties": {
            "fetch_status": true,
            "branch_max_length": 32,
            "branch_icon": " "
          },
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#d7af00{{ end }}"
          ]
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#444444",
          "background": "transparent",
          "template": ""
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hidden",
      "filler": "<#6c6c6c>─</>",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#444444",
          "background": "transparent",
          "template": ""
        },
        {
          "type": "status",
          "style": "plain",
          "background": "#444444",
          "foreground": "#5faf00",
          "template": " {{ .String }} ",
          "properties": {
            "always_enabled": true
          },
          "foreground_templates": [
            "{{ if gt .Code 0 }}#d70000{{ end }}"
          ]
        },
        {
          "type": "executiontime",
          "style": "plain",
          "background": "#444444",
          "foreground": "#a8a8a8",
          "template": "<#949494></> {{ .FormattedMs }} ",
          "properties": {
            "threshold": 3000,
            "style": "round"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "background": "#444444",
          "foreground": "#00afaf",
          "template": "<#949494></> {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "fetch_virtual_env": true,
            "display_mode": "context"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "background": "#444444",
          "foreground": "#00afaf",
          "template": "<#949494></> {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "background": "#444444",
          "foreground": "#5faf00",
          "template": "<#949494></> {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "context"
          }
        },
        {
          "type": "ruby",
          "style": "plain",
          "background": "#444444",
          "foreground": "#d75f87",
          "template": "<#949494></> {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "kubectl",
          "style": "plain",
          "background": "#444444",
          "foreground": "#af5fd7",
          "template": "<#949494></> {{ .Context }}{{ if .Namespace }}/{{ .Namespace }}{{ end }} ",
          "properties": {
            "display_error": false,
            "parse_kubeconfig": true
          }
        },
        {
          "type": "terraform",
          "style": "plain",
          "background": "#444444",
          "foreground": "#00afd7",
          "template": "<#949494></> {{ .WorkspaceName }} ",
          "properties": {
            "display_default": false
          }
        },
        {
          "type": "aws",
          "style": "plain",
          "background": "#444444",
          "foreground": "#ff8700",
          "template": "<#949494></> {{ .Profile }}{{ if .Region }}/{{ .Region }}{{ end }} ",
          "properties": {
            "display_default": false
          }
        },
        {
          "type": "az",
          "style": "plain",
          "background": "#444444",
          "foreground": "#0087d7",
          "template": "<#949494></> {{ .Name }} ",
          "properties": {
            "display_default": false
          }
        },
        {
          "type": "gcp",
          "style": "plain",
          "background": "#444444",
          "foreground": "#0087d7",
          "template": "<#949494></> {{ .Project }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#444444",
          "background": "transparent",
          "template": ""
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "background": "transparent",
          "template": "╰─"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#6c6c6c",
    "background": "transparent",
    "template": "╰─ "
  },
  "secondary_prompt": {
    "foreground": "#6c6c6c",
    "background": "transparent",
    "template": "├─ "
  }
}
